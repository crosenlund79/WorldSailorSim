msgstr "er %dx%d, men bør have formen %dx%d (forhold %.3f, ikke %.3f)"

msgid "Too fast to troll: %.1f kn. A trolled lure only works below %d kn; wait for a gentler stretch or anchor."
msgstr "For hurtigt til slæbefiskeri: %.1f kn. Et slæbt blink virker kun under %d kn; vent på roligere vand eller ankr."

msgid "The line is skipping on the surface at %.1f kn: too fast to troll. Bring it in, or wait for a gentler stretch."
msgstr "Linen hopper i overfladen ved %.1f kn: for hurtigt til slæb. Hal den ind, eller vent på roligere vand."

msgid "An exceptional fish: %s, %.1f kg"
msgstr "En enestående fisk: %s, %.1f kg"

msgid "%s, %.1f kg"
msgstr "%s, %.1f kg"

msgid "Good for the normal anchor (%s, %s; land %.1f nm away). How sheltered it is depends on the wind when you arrive."
msgstr "Godt for det normale anker (%s, %s; land %.1f sm væk). Hvor meget læ der er, afhænger af vinden ved ankomst."

msgid "New personal best: %s, %.1f kg"
msgstr "Ny personlig rekord: %s, %.1f kg"

