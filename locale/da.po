msgid "Travel update… (%d renown)"
msgstr "Rejseopdatering … (%d omdømme)"

msgid "Published so far"
msgstr "Udgivet indtil nu"

msgid "%d postcards in the scrapbook. %d travel updates, %d renown shared, %s earned."
msgstr "%d postkort i scrapbogen. %d rejseopdateringer, %d omdømme delt, %s tjent."

msgid "%d of %d unlocked. Unlocked achievements come first, the most recent at the top."
msgstr "%d af %d låst op. Låste op bedrifter står først, de nyeste øverst."

msgid "All"
