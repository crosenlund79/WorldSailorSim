msgstr "Sejlmager"

msgid "sail care, new sailcloth"
msgstr "sejlpleje, ny sejldug"

msgid "Fishmonger"
msgstr "Fiskehandler"

msgid "sells your catch"
msgstr "køber din fangst"

msgid "Sold at the chandlery, next to the yard."
msgstr "Sælges i skibshandlen ved siden af værftet."

