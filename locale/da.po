msgid_plural "Missed - the line slips. %d grips left."
msgstr[0] "Forbi - linen glider. %d tag tilbage."
msgstr[1] "Forbi - linen glider. %d tag tilbage."

msgid "Missed..."
msgstr "Forbi..."

msgid "%d Perfect hit: a little heavier for your care."
msgid_plural "%d Perfect hits: a little heavier for your care."
msgstr[0] "%d perfekt træf: lidt tungere for din omhu."
msgstr[1] "%d perfekte træf: lidt tungere for din omhu."

msgid "Missed - it skips over the bottom (%d min). %d tries left."
msgstr "Forbi - det springer hen over bunden (%d min). %d forsøg tilbage."


msgid "%sA good anchorage: sheltered from this wind (depth %s; land %.1f nm away)."
msgstr "%sEn god ankerplads: i læ for denne vind (dybde %s; land %.1f sm væk)."

msgid "%sA fair anchorage: partly sheltered from this wind (depth %s; land %.1f nm away)."
msgstr "%sEn rimelig ankerplads: delvis i læ for denne vind (dybde %s; land %.1f sm væk)."

msgid "%sAn exposed anchorage: this wind blows straight in over %.0f+ nm of open water. Holding may be poor (depth %s)."
msgstr "%sEn åben ankerplads: vinden blæser lige ind over %.0f+ sm åbent vand. Ankeret kan holde dårligt (dybde %s)."

msgid "%.1f kn possible under sail in %d kn of wind"
msgstr "%.1f kn mulig for sejl i %d kn vind"

