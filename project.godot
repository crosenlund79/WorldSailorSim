; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Little Captain's Hat"
config/description="A cozy sailing adventure about making a home on the water and exploring the world at your own pace. (Developed as Next Harbor until Iteration 006.)"
config/version="0.109a"
run/main_scene="res://src/app/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.133, 0.18, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/png/little_captains_hat_logo_240.png"
config/icon="res://assets/branding/little_captains_hat_icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Little Captains Hat"

[autoload]

SettingsManager="*res://src/settings/settings_manager.gd"
AudioManager="*res://src/audio/audio_manager.gd"
GameSession="*res://src/core/game_session.gd"
Simulation="*res://src/core/simulation.gd"
SaveManager="*res://src/persistence/save_manager.gd"
SessionLog="*res://src/diagnostics/session_log.gd"
UiTheme="*res://src/ui/theme/ui_theme.gd"
MusicDirector="*res://src/audio/music_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/next_harbor_theme.tres"

