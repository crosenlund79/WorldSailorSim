[resource]
script = ExtResource("1_def")
id = &"arctic_wanderer_26"
display_name = "Arctic Wanderer 26"
hull_type = "monohull"
description = "A small, sturdy 26 ft sloop: your first boat. A tiller, a snug cockpit and one cosy cabin. Slower than the bigger boats, but seaworthy."
price = 6000
specs = Dictionary[String, String]({"Length": "7.9 m (26 ft)", "Beam": "2.6 m", "Accommodation": "V-berth, two settees, small galley", "Engine": "Small diesel", "Passage stores": "32 days"})
performance = ExtResource("2_perf")
deck_scene = ExtResource("3_deck")
cabin_scene = ExtResource("4_cabin")
deck_visual_scene = ExtResource("5_visual")
visual_profile = ExtResource("6_profile")
illustrated_visual_profile = ExtResource("7_illustrated")
passage_stores_days = 32.0
