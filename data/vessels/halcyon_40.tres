specs = Dictionary[String, String]({"Length": "12.2 m (40 ft)", "Beam": "6.8 m", "Accommodation": "Bridgedeck saloon, owner's berth in the port hull, guest cabin", "Engine": "Twin diesels", "Passage stores": "45 days"})
