{
	"note": "I021, A Wider, Warmer World: what each harbour looks like beyond the guest pontoon. Looks are chosen per harbour by its buildings, materials, land and climate, never by the continent alone. A harbour with its own art (data/harbours/<id>.tres with landmarks) shows that instead, and those are the special harbours listed under special (shown on the chart with the reason). Art: tools/harbours/paint_harbour_looks.py. See docs/iterations/i021/HARBOUR_LOOKS.md.",
	"looks": {
		"nordic_timber": {
			"title": "Nordic timber harbour",
			"texture": "res://assets/harbours/looks/nordic_timber.png",
			"about": "Painted timber houses and boat sheds with steep roofs: the fishing harbours of Scandinavia, the Faroes and Iceland, and timber towns elsewhere that look the same (Atlantic Canada, New Zealand)."
		},
		"gabled_waterfront": {
			"title": "Gabled harbour town",
			"texture": "res://assets/harbours/looks/gabled_waterfront.png",
			"about": "Brick and rendered townhouses with stepped and curved gables: Danish and German harbour towns, the Hanseatic Baltic, the Low Countries, and Dutch- and Cape Dutch-built waterfronts."
		},
		"atlantic_stone": {
			"title": "Stone harbour of the Atlantic coast",
			"texture": "res://assets/harbours/looks/atlantic_stone.png",
			"about": "Grey granite and sandstone houses with slate roofs and chimneys: Scotland, Ireland, Wales, Brittany, Normandy, Galicia, the Channel Islands, Helsinki's stone quays and Hobart's sandstone warehouses."
		},
		"mediterranean": {
			"title": "Mediterranean harbour town",
			"texture": "res://assets/harbours/looks/mediterranean.png",
			"about": "Warm rendered and stone houses with terracotta roofs and shutters, a bell tower: Italy, southern France and the French Atlantic's limestone towns, Spain, Portugal, Croatia, mainland Greece, Türkiye, Cyprus and Malta."
		},
		"aegean_island": {
			"title": "Aegean island harbour",
			"texture": "res://assets/harbours/looks/aegean_island.png",
			"about": "Whitewashed houses with blue doors, flat roofs and a chapel dome: the Cyclades and the small Greek islands."
		},
		"stone_town": {
			"title": "Stone town harbour",
			"texture": "res://assets/harbours/looks/stone_town.png",
			"about": "Lime-washed masonry with arched doors and roof terraces behind a sea wall: Morocco's Atlantic coast and the Swahili coast's stone towns."
		},
		"tropical_town": {
			"title": "Tropical harbour town",
			"texture": "res://assets/harbours/looks/tropical_town.png",
			"about": "Low painted houses with tin roofs and verandas among palms and mango trees: the Caribbean, West Africa, the Indian Ocean, Central America and the larger Pacific towns."
		},
		"tropical_island": {
			"title": "Tropical island harbour",
			"texture": "res://assets/harbours/looks/tropical_island.png",
			"about": "Small timber and thatched buildings among palms on a beach: the islands of Polynesia, the Cook Islands, Tonga and the Grenadines."
		},
		"volcanic_island": {
			"title": "Volcanic island harbour",
			"texture": "res://assets/harbours/looks/volcanic_island.png",
			"about": "Green slopes and dark lava rock, a few white houses and a white church: the Azores, Madeira, Lanzarote, the Galápagos, the Marquesas, Samoa and St Helena."
		}
	},
